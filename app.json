{
  "expo": {
    "name": "SiteKhata",
    "slug": "sitekhata",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo3.png",
    "scheme": "sitekhata",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo3.png",
        "backgroundImage": "./assets/images/logo3.png",
        "monochromeImage": "./assets/images/logo3.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.SiteKhata"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo3.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo3.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8e3933d5-dc1e-41b3-a112-bd0ce5b00a6d"
      }
    },
    "owner": "site-khata"
  }
}
